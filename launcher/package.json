{
  "name": "bestclient-launcher",
  "version": "0.5.5",
  "private": true,
  "description": "BestClient launcher",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n next,electron -c magenta,cyan \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "next dev -p 4571",
    "dev:main": "npm run build:main && wait-on tcp:127.0.0.1:4571 && cross-env BESTCLIENT_DEV=1 electron .",
    "build:main": "tsc -p electron/tsconfig.json && npm run build:preload",
    "_comment:build:preload": "Sandboxed preload scripts cannot require() relative modules, so the preload must be bundled into one self-contained file. Runs after tsc and overwrites its output.",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist-electron/preload.js",
    "build:renderer": "next build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.1"
  }
}
